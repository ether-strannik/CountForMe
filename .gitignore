# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Installed, never committed: F-Droid's scanner rejects prebuilt binaries
# in a source tree, and the lock file is what pins the versions anyway.
node_modules/

# The build directory Capacitor used before the project moved in here.
www/

# The release checklist. Working notes, not part of the app.
TASKS.md

# Written into web/ by `cap sync`, because the build's working copy
# reaches this folder by symlink rather than by copy -- which is what
# keeps the APK from ever shipping a stale page. Generated, never source.
web/cordova.js
web/cordova_plugins.js
